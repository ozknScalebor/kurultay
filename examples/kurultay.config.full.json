{
  "$comment": "Full Kurultay example – a typical setup on a closed network: vLLM on two GPU servers, llama.cpp and Ollama on a workstation. Copy it to the project root as kurultay.config.json. For a single server the short form in kurultay.config.simple.json is enough.",
  "endpoints": [
    {
      "name": "gpu1-vllm",
      "baseUrl": "http://10.10.0.11:8000/v1",
      "apiKey": "${GPU1_API_KEY}",
      "models": [],
      "maxConcurrency": 0,
      "timeoutMs": 600000
    },
    {
      "name": "gpu2-vllm",
      "baseUrl": "http://10.10.0.12:8000/v1",
      "apiKey": "${GPU2_API_KEY}"
    },
    {
      "name": "ws-llamacpp",
      "baseUrl": "http://10.10.0.20:8080/v1",
      "apiKey": "none",
      "models": [
        "qwen3-coder-30b-a3b"
      ],
      "maxConcurrency": 2,
      "firstTokenTimeoutMs": 300000
    },
    {
      "name": "ollama",
      "baseUrl": "http://127.0.0.1:11434/v1",
      "apiKey": "ollama",
      "models": [
        "qwen2.5-coder:14b",
        {
          "id": "deepseek-coder-v2:16b",
          "apiKey": "${DEEPSEEK_KEY}"
        }
      ]
    }
  ],
  "models": {
    "qwen2.5-coder:14b@ollama": {
      "contextWindow": 32768,
      "extraBody": {
        "options": {
          "num_ctx": 32768
        }
      }
    },
    "gpt-oss-120b@gpu2-vllm": {
      "roles": [
        "planner",
        "judge",
        "reviewer"
      ]
    },
    "tiny-model@ollama": {
      "disabled": true
    }
  },
  "verify": {
    "build": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build -j",
    "test": "ctest --test-dir build --output-on-failure",
    "lint": "",
    "timeoutMs": 900000
  },
  "orchestrator": {
    "defaultMode": "auto",
    "raceWidth": 3,
    "councilSize": 3,
    "maxIterations": 4,
    "maxStepsPerWorker": 40,
    "maxConsecutiveErrors": 6,
    "confirmMerge": true,
    "approvePlan": false,
    "maxTokens": 2000000,
    "maxMinutes": 90,
    "testFirst": true
  },
  "index": {
    "include": [],
    "exclude": [
      "third_party/**",
      "*.pb.cc",
      "*.pb.h",
      "generated/**"
    ],
    "maxFileBytes": 524288,
    "summaryLanguage": "en",
    "repoMapTokens": 2048
  },
  "tools": {
    "allowCommands": true,
    "commandTimeoutMs": 600000,
    "requireReadBeforeEdit": true,
    "isolation": "sandbox",
    "sandbox": {
      "size": 4,
      "link": [
        "node_modules"
      ]
    },
    "syntaxCheck": "auto",
    "commandPolicy": "deny",
    "allowPatterns": [
      "^\\./tools/gen\\.sh\\b"
    ],
    "scrubEnv": true,
    "envPassthrough": [
      "CONAN_LOGIN_USERNAME"
    ],
    "osSandbox": "off"
  },
  "llm": {
    "firstTokenTimeoutMs": 180000,
    "prefillMsPerToken": 2,
    "idleTimeoutMs": 90000,
    "timeoutMs": 600000,
    "timeoutRetries": 0,
    "timeoutCooldownMs": 120000,
    "stickyFailover": true
  },
  "embeddings": {
    "mode": "auto",
    "endpoint": "gpu1-vllm",
    "model": "bge-m3"
  },
  "mcp": {
    "servers": {
      "issue-tracker": {
        "command": "node",
        "args": [
          "/opt/mcp/jira-mcp.js"
        ],
        "env": {
          "JIRA_URL": "http://jira.local"
        },
        "readOnlyTools": [
          "search_issues",
          "get_issue"
        ],
        "timeoutMs": 60000
      }
    }
  },
  "lsp": {
    "servers": {
      "clangd": {
        "command": "clangd",
        "args": [
          "--background-index=false"
        ],
        "extensions": [
          ".c",
          ".cc",
          ".cpp",
          ".h",
          ".hpp"
        ]
      }
    }
  },
  "skills": {
    "paths": [
      "~/shared-skills"
    ],
    "disabled": [],
    "includeUser": true,
    "maxPreload": 3
  },
  "language": "en"
}